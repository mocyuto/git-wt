{
  "name": "zgt development",
  "build": {
    "dockerfile": "Dockerfile",
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
    },
  },
  "mounts": ["source=zgt-gomodcache,target=/go/pkg/mod,type=volume"],
  "containerEnv": {
    "OPENCODE_CONFIG": "${containerWorkspaceFolder}/.devcontainer/opencode.jsonc",
  },
  "postCreateCommand": "bash .devcontainer/init.sh",
  "remoteUser": "vscode",
}
